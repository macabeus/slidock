  "conventions": {
    "dir": "the direction the content moves, in OOXML tokens (docs/format.md §5.2)",
    "slides": "by 1-based index; both exports keep the deck's 31 slides in order",
    "shape": "the target shape's text, paragraphs joined with |: our own labels, one effect per labelled shape",
    "transition": "effect and params as both formats should read them; pptx/odp hold each format's native id and duration and, where a format reads otherwise, what it reads instead, with `explained`",
    "steps": "kind, effect, params, trigger, delivery, paragraphs and durationMs as both formats read them; native ids per format; a `pptx` or `odp` object holds what that format reads instead, with `explained`. A step with neither agrees across the formats",
    "fallback": "effect null: no vocabulary entry; the transition or step plays `fallback`, reported with `diagnostic`"
  },
  "writes": {
    "Flip": {
      "pptx": "mc:AlternateContent: Choice Requires=\"p14\" <p:transition spd=\"med\"><p14:flip dir=\"l\"/>, Fallback <p:fade/>",
      "odp": "nothing (no transition)"
    },
    "Cube": {
      "pptx": "mc:AlternateContent: Choice Requires=\"p14\" <p14:prism dir=\"l\"/> (no isContent, no isInverted), Fallback <p:fade/>; Keynote's own PPTX export writes its Cube the same way",
      "odp": "transitionFilter miscShapeWipe cornersOut (LibreOffice's OpenGL outside-cube)"
    },
    "Gallery": {
      "pptx": "mc:AlternateContent: Choice Requires=\"p14\" <p14:gallery dir=\"l\"/>, Fallback <p:fade/>",
      "odp": "nothing (no transition)"
    },
    "Dissolve": {
      "pptx": "<p:fade/>",
      "odp": "fade crossfade"
    },
    "durations": {
      "pptx": "spd only, or spd with p14:dur (mc:AlternateContent) for a slider value",
      "odp": "transitionFilter smil:dur 2s, or 3s with transition-speed slow"
    },
    "odpPresets": "every preset Google's ODP export writes is one of LibreOffice's effects.xml ids with one of its sub-types: ooo-entrance-appear, ooo-exit-disappear, ooo-entrance-fade-in, ooo-exit-fade-out, ooo-entrance-fly-in and ooo-exit-fly-out (from-left, from-right, from-bottom, from-top), ooo-entrance-zoom (in), ooo-exit-zoom (out), ooo-emphasis-spin; its behaviours are Google's own (x/y and width/height animate with SMIL values, no transitionFilter for fly or zoom)",
    "paragraphs": "PPTX: one effect per paragraph targeting p:txEl/p:pRg, no p:bldLst; ODP: one effect per paragraph targeting its text:p xml:id, inside a frame that has no id of its own"
  },
