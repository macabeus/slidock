{
  "name": "@slidock/player",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/player.mjs"
    },
    "./presenter": {
      "types": "./src/presenter/index.ts",
      "default": "./dist/presenter.mjs"
    },
    "./player.iife.js": "./dist/player.iife.js",
    "./presenter.iife.js": "./dist/presenter.iife.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "node build.mjs",
    "lint": "eslint src test e2e build.mjs esbuild.config.mjs vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "e2e": "node build.mjs && playwright test -c e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@slidock/types": "workspace:*",
    "esbuild": "0.28.2",
    "happy-dom": "21.0.3",
    "vitest": "4.1.12"
  }
}
