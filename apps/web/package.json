{
  "name": "@slidock/web",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node ../../packages/wasm/require-pkg.mjs && vite",
    "build": "node ../../packages/wasm/require-pkg.mjs && vite build",
    "preview": "vite preview",
    "lint": "eslint src test e2e csp.ts notices.ts substitutes.ts vite.config.ts vitest.config.ts playwright.config.ts",
    "typecheck": "node ../../packages/wasm/require-pkg.mjs && tsc -p tsconfig.json",
    "test": "node ../../packages/wasm/require-pkg.mjs && vitest run",
    "e2e": "playwright test",
    "e2e:smoke": "SLIDOCK_E2E_SMOKE=1 playwright test",
    "e2e:pages": "playwright test --config e2e/pages/pages.config.ts"
  },
  "dependencies": {
    "@slidock/player": "workspace:*",
    "@slidock/types": "workspace:*",
    "@slidock/ui": "workspace:*",
    "@slidock/wasm": "workspace:*",
    "react": "19.2.9",
    "react-dom": "19.2.9"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "tailwindcss": "4.3.3",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  }
}
